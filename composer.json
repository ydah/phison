{
  "name": "ydah/phison",
  "description": "A LALR(1) parser generator for PHP.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/ydah/phison",
  "keywords": [
    "lalr",
    "parser-generator",
    "php",
    "yacc"
  ],
  "support": {
    "issues": "https://github.com/ydah/phison/issues",
    "source": "https://github.com/ydah/phison"
  },
  "require": {
    "php": ">=8.2 <9.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Phison\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Phison\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/phison"
  ],
  "scripts": {
    "lint": "find bin src examples tests benchmarks -type f \\( -name '*.php' -o -name phison \\) -print0 | xargs -0 -n1 php -l",
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "benchmark": "php benchmarks/arithmetic.php",
    "validate:example": "php examples/manage.php validate arithmetic",
    "generate:example": "php examples/manage.php generate arithmetic",
    "run:example": "php examples/manage.php run arithmetic",
    "validate:examples": "php examples/manage.php validate",
    "generate:examples": "php examples/manage.php generate",
    "run:examples": "php examples/manage.php run"
  }
}
