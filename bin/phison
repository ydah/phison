#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/../vendor/autoload.php';
if (is_file($autoload)) {
    require $autoload;
} else {
    require __DIR__ . '/../src/autoload.php';
}

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'] ?? [];

exit((new Phison\Cli\Application())->run($arguments));
